# Copy to .env and fill in your key.
# Values in this file are loaded automatically from the project root
# (even if you run from another cwd). They override stale shell exports.

OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
# fake = offline FakeProposer; live = real OpenAI
GOVERNED_LLM_MODE=live
# Optional overrides for durable files (defaults under logs/)
# GOVERNED_AUDIT_LOG=/var/log/governed_llm/audit.jsonl
# GOVERNED_IDEMPOTENCY_STORE=/var/log/governed_llm/idempotency_refunds.json
